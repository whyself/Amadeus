{
  "name": "amadeus-workspace",
  "version": "1.1.3",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:editor-browser": "node tests/editor-browser.mjs",
    "test:editor-live": "node tests/editor-code-server-browser.mjs",
    "start": "node scripts/start.mjs",
    "pack:plugins": "node scripts/pack.mjs",
    "setup:browsers": "node node_modules/@playwright/mcp/cli.js install-browser --with-deps chromium"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "js-yaml": "4.3.2",
    "ws": "8.21.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@playwright/mcp": "0.0.82",
    "@playwright/test": "1.58.2",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/whyself/Amadeus.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "amadeus"
  ]
}
